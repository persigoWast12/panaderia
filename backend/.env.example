# Copiá este archivo como .env (al lado de main.py) y completá tus datos.

# Conexión a la base PostgreSQL "panaderia" (ya creada desde pgAdmin).
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/panaderia

# La red local usa HTTP, así que la cookie de sesión va sin Secure.
# Si algún día se sirve por HTTPS, poner true.
COOKIE_SECURE=false

# Duración de la sesión, en horas.
SESSION_HOURS=12
